# =============================================================================
# NextDrop AI Release Strategist - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running the app.
# Do NOT commit .env to version control.

# --- Application ---------------------------------------------------------------
APP_NAME="NextDrop AI Release Strategist"
APP_ENV="development"          # development | staging | production
DEBUG=true
SECRET_KEY="change-this-to-a-long-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://nextdrop_user:nextdrop_password@localhost:5432/nextdrop_db"
DATABASE_SYNC_URL="postgresql+psycopg://nextdrop_user:nextdrop_password@localhost:5432/nextdrop_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Redis (Celery broker & result backend) ------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# --- File Storage --------------------------------------------------------------
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
DATA_MERGED_DIR="data/merged"
DATA_FEATURES_DIR="data/features"
DATA_MODELS_DIR="data/models"
AUDIO_UPLOAD_DIR="uploads/audio"
MAX_AUDIO_UPLOAD_SIZE_MB=50

# --- ML Configuration ----------------------------------------------------------
ACTIVE_MODEL_PATH="data/models/release_model.pkl"
OPTUNA_N_TRIALS=100
OPTUNA_TIMEOUT_SECONDS=3600
CV_N_SPLITS=5
EARLY_STOPPING_ROUNDS=20
TOP_N_RECOMMENDATIONS=5

# --- PSI Drift Thresholds ------------------------------------------------------
PSI_WARNING_THRESHOLD=0.1
PSI_ALERT_THRESHOLD=0.25

# --- External APIs (optional) --------------------------------------------------
MAPBOX_ACCESS_TOKEN=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- CORS ----------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
